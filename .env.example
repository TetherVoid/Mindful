# Get these from your Supabase project: Settings -> API.
#
# Production is the `Mindful` project, ref czvejcytunugftbspxmr (Mumbai). The
# older ydbhuynqjymfkqllijzc (Seoul) project is deprecated — see
# supabase/MIGRATIONS.md. If either value below still names that ref, it is
# wrong.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Local development without a Supabase project ---------------------------
# Set to true to run the app against seeded local fixtures instead. Only has
# any effect in `npm run dev` — production builds always use the real client.
VITE_USE_FIXTURES=false
# empty | week | heavy   (default: week)
#   empty — day one, every list empty. The hardest case for the layout.
#   week  — a realistic week or so of history.
#   heavy — 200+ records, long strings, multi-line notes.
VITE_FIXTURE_SCENARIO=week
# Set to true to land on the sign-in page instead of an already-signed-in session.
VITE_FIXTURE_SIGNED_OUT=false
# Simulated request latency in ms, so loading states are actually visible.
VITE_FIXTURE_LATENCY=220
#
# Fixtures cannot stand in for roles and classes. There is no row-level security
# behind the fixture client, so a teacher view that worked here would prove
# nothing about whether it works against a real project — the class functions
# return an explanatory error on sample data rather than a made-up roster.

# --- Sign-in ----------------------------------------------------------------
# Which third-party sign-in buttons to offer, comma separated: google, apple.
# Listing one here only shows the button; the provider must also be enabled and
# configured in the Supabase dashboard. See supabase/OAUTH.md.
VITE_OAUTH_PROVIDERS=
#
# Where a provider (and an email confirmation link) sends the browser back to.
# Defaults to <this origin>/auth/callback, which is right for local development
# and for a single production domain. Set it explicitly when previews and
# production do not share an origin; it should still end in /auth/callback,
# which is the route that waits for the session to be exchanged.
#
# Whatever you put here must ALSO be on the project's redirect allow-list:
# Authentication -> URL Configuration in the Supabase dashboard.
# VITE_AUTH_REDIRECT_URL=

# --- The reading (/report) --------------------------------------------------
# Set on the server only (Vercel project env vars), NOT with a VITE_ prefix —
# a VITE_ variable is inlined into the client bundle and would be public.
#
# Without this key /api/report answers 503 and the app writes the report in the
# browser instead, which always works but is written from templates.
ANTHROPIC_API_KEY=
#
# /api/report verifies the caller's Supabase session before spending tokens.
# It falls back to the VITE_ pair above, so these are only needed if the
# function's own project vars differ from the build's.
#
# If you do set them, they must name THE SAME PROJECT as the VITE_ pair. A
# deployment where the browser signs in against one project and the functions
# verify against another authenticates nobody in particular, so
# supabaseRestConfig() in api/_lib/auth.js refuses the request outright (503)
# rather than picking one.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# --- Account deletion (/api/account) ----------------------------------------
# Server only. NEVER give this a VITE_ prefix and never expose it to the
# browser: the service role bypasses row-level security completely, so a leaked
# service key is every user's data, not just the holder's.
#
# It is used for exactly one thing — DELETE /api/account, which removes the
# caller's own auth user (and by cascade all their rows). Without it that
# endpoint answers 503 and Settings can still delete a user's data, just not
# the account itself.
#
# Supabase dashboard: Settings -> API -> service_role (reveal).
# SUPABASE_SERVICE_ROLE_KEY=
