# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# local fixture builds (see .env.example)
dist-fixtures
dist-empty
dist-heavy

# graphify knowledge graph (regenerate with: graphify update .)
graphify-out/

# Supabase CLI local working state. Created by `supabase start`/`db reset`.
# .temp holds the linked project ref and pooler details — not for version control.
supabase/.branches
supabase/.temp

# Written by `vercel link`. .vercel holds the project/org ids and a short-lived
# VERCEL_OIDC_TOKEN; .env* holds real keys. Neither belongs in version control.
#
# .env.example is the exception and must stay tracked: it is the documented
# contract for every variable the app reads, and it holds no values. The
# negation has to come after the .env* line to take effect.
.vercel
.env*
!.env.example

# Claude Code: agents, skills and settings.json are shared and tracked; these two
# are per-machine (the desktop app's preview config and personal overrides).
.claude/launch.json
.claude/settings.local.json

# Visual sweep output (scripts/sweep/run.mjs)
sweep-out/
