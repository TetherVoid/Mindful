{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "ecc@ecc": false
  },
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm test)",
      "Bash(node scripts/check-boundaries.mjs)",
      "Bash(node scripts/check-deploy-config.mjs)",
      "Bash(supabase test db --local)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)",
      "Bash(supabase migration repair:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel promote:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-migrations.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-remote.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
